.{
    .name = .zrk,
    .version = "3.0.0-alpha.3",
    .fingerprint = 0x614e97303b45a75a, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The runtime. Connections run as coroutines on zio's event loop.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#38206678edca2abf4e27ce18bb963bfa6f4297ab",
            .hash = "zio-0.17.0-xHbVVK-DKABkbm_XZgK-21SgNvYr9U5zr1MgOw7Q6JtM",
        },
        // The HTTP/2 frame codec and HPACK, shared with zoxy. See build.zig
        // for why zrk builds it with `assertions = false`.
        .h2 = .{
            .url = "git+https://github.com/zoxy-io/h2#ce82b9a886435d8fdd53e1a8cfbe72ed918fb53e",
            .hash = "h2-0.0.0--ngLtzZFBgCrbAucjP1hgw2-vJ2K12mf-04oR-EdzitD",
        },
        // A std.Io-native HTTP/1.1 client. zrk imports one layer of it, the
        // response parser, which owns framing — chunked, bodyless statuses,
        // TE-beats-CL, conflicting Content-Length. The request stays zrk's,
        // built once and replayed rather than re-serialized per send; see
        // src/http.zig.
        //
        // Nothing in the graph doubles up through it: zurl reaches its
        // transport as `*Io.Reader`/`*Io.Writer`, so it pins no runtime, and
        // the TLS it does carry is std's, not a second libcrypto. Its one
        // transitive pin, hparse, is std-only too.
        .zurl = .{
            .url = "git+https://github.com/zoxy-io/zurl#4ecb1768985425d4f09b317f23f203983ef87d96",
            .hash = "zurl-0.0.0--VALCi1dBQA6i4gkVVX11IV13I784dueJYYAzyZZTBPz",
        },
        // TLS 1.3, and the libcrypto under it — one dependency, one module,
        // with no system OpenSSL involved. build.zig has the build-side
        // consequences.
        //
        // zssl is sans-I/O: it owns no socket, no allocator and no entropy.
        // What that buys is that the protocol state machine — where TLS CVEs
        // live — is auditable Zig, with libcrypto reduced to the constant-time
        // primitives. What it costs is that `src/tls.zig` is no thin wrapper:
        // the `std.Io` adapter and the X.509 chain and hostname verification
        // are zrk's now, because zssl deliberately declines both. That trade
        // is the whole point; see src/tls.zig.
        .zssl = .{
            .url = "git+https://github.com/zoxy-io/zssl#b6a65537b394931b80dbdfa25ec7763b5837b7ae",
            .hash = "zssl-0.0.1-5ocyiNy-DgCb3DwVFeLhGK8x9olBEfyuRarEMDuMcIl8",
        },
        // QUIC, QPACK and HTTP/3 — sans-I/O, like h2 and zssl. It opens no
        // socket, reads no clock, draws no entropy and runs no TLS handshake:
        // `src/h3conn.zig` supplies all four, and `src/quic_tls.zig` is the
        // fourth because zssl declines QUIC (see its README, "Out, for now").
        //
        // Pinned at the commit that fixes the acknowledgement-report
        // truncation this prototype found: below it, a connection carrying
        // more than one stream strands them once the congestion window grows
        // past thirty-two packets. `src/h3conn.zig` has the diagnosis.
        //
        .h3 = .{
            .url = "git+https://github.com/zoxy-io/h3#3accaf4b8d35d299315927296c0bc49b5f5ffc3a",
            .hash = "h3-0.0.0-RBkp8tYDFwAKtZHosUA5okrC2lg9y6gFkh4BZvmtvZSI",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
